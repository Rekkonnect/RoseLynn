<Project>
  <PropertyGroup>
    <LangVersion>14.0</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Nullable>enable</Nullable>
    <Version>0.7.0</Version>
    <PackageVersion>$(Version)</PackageVersion>
  </PropertyGroup>

  <!-- Those should be only applied to packable projects, not all -->
  <PropertyGroup Label="Package Metadata">
    <Authors>Rekkonnect</Authors>
    <Company>Rekkonnect</Company>
    <Copyright>© 2021-2026, Rekkonnect</Copyright>
  </PropertyGroup>
  
  <!-- Those should be converted into centralized package management -->
  <PropertyGroup Label="Dependency versions">
    <GaryonVersion>0.4.3</GaryonVersion>
    <MicrosoftCodeAnalysisVersion>5.3.0</MicrosoftCodeAnalysisVersion>
    <MicrosoftCodeAnalysisTestingVersion>1.1.3</MicrosoftCodeAnalysisTestingVersion>
    <NuGetClientVersion>7.3.1</NuGetClientVersion>
    <TUnitVersion>1.39.0</TUnitVersion>
    <RoseLynnLegacyVersion>0.6.2</RoseLynnLegacyVersion>
  </PropertyGroup>
</Project>