<Project>
  <PropertyGroup>
    <LangVersion>14.0</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>1.0.0</Version>
    <PackageVersion>$(Version)</PackageVersion>
    <NoWarn>$(NoWarn);NU5129;RS1042;RS1038</NoWarn>
  </PropertyGroup>

  <!-- Those should be only applied to packable projects, not all -->
  <PropertyGroup Label="Package Metadata">
    <Authors>Rekkonnect</Authors>
    <Company>Rekkonnect</Company>
    <Copyright>© 2021-2026, Rekkonnect</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <RepositoryUrl>https://github.com/Rekkonnect/RoseLynn</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/Rekkonnect/RoseLynn</PackageProjectUrl>
  </PropertyGroup>

  <ItemGroup Label="License reference">
    <None Include="$(MSBuildThisFileDirectory)LICENSE" Pack="true" PackagePath="\" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>
</Project>