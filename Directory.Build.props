<Project>
  <PropertyGroup>
    <LangVersion>14.0</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Version>0.7.0</Version>
    <PackageVersion>$(Version)</PackageVersion>
    <GaryonVersion>0.4.3</GaryonVersion>
    <MicrosoftCodeAnalysisVersion>5.3.0</MicrosoftCodeAnalysisVersion>
    <MicrosoftCodeAnalysisTestingVersion>1.1.3</MicrosoftCodeAnalysisTestingVersion>
    <NuGetClientVersion>7.3.1</NuGetClientVersion>
    <TUnitVersion>1.39.0</TUnitVersion>
    <RoseLynnLegacyVersion>0.6.2</RoseLynnLegacyVersion>
  </PropertyGroup>
</Project>