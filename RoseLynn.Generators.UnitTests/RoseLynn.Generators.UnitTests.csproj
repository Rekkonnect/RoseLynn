<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis"  />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Analyzer.Testing"  />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.SourceGenerators.Testing"  />
    <PackageReference Include="Garyon"  />
    <PackageReference Include="Microsoft.NET.Test.Sdk"  />
    <PackageReference Include="TUnit"  />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Resources/**/*.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\src\RoseLynn.Generators\RoseLynn.Generators.csproj" />
  </ItemGroup>

  <Target Name="CopyResourceFiles" AfterTargets="Build">
    <ItemGroup>
      <ResourceFiles Include="Resources/**/*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(ResourceFiles)" DestinationFolder="$(TargetDir)/Resources/%(RecursiveDir)" />
  </Target>

</Project>
