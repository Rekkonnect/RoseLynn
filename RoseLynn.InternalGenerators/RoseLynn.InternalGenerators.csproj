<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <NoWarn>$(NoWarn);RS1042;RS1038</NoWarn>

    <Version>0.7.0</Version>

    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <Configurations>Debug;Release;Release Test</Configurations>
  </PropertyGroup>

  <Import Project="InferTransitiveDependencies.props" />

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="5.3.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>

    <PackageReference Include="Microsoft.CodeAnalysis" Version="5.3.0" PrivateAssets="all" />

    <!-- The meta is too strong in this one-->
    <PackageReference Include="Garyon" Version="0.4.3" PrivateAssets="all"  />
    <PackageReference Include="RoseLynn" Version="0.6.2" PrivateAssets="all"  />
    <PackageReference Include="RoseLynn.VS2019" Version="0.6.2" PrivateAssets="all"  />
    <PackageReference Include="RoseLynn.Analyzers" Version="0.6.2" PrivateAssets="all"  />
    <PackageReference Include="RoseLynn.Analyzers.VS2019" Version="0.6.2" PrivateAssets="all"  />
    <PackageReference Include="RoseLynn.Generators" Version="0.6.2" PrivateAssets="all"  />
    <PackageReference Include="RoseLynn.Generators.VS2019" Version="0.6.2" PrivateAssets="all"  />
  </ItemGroup>

  <PropertyGroup>
    <GetTargetPathDependsOn>$(GetTargetPathDependsOn);GetDependencyTargetPaths</GetTargetPathDependsOn>
  </PropertyGroup>

  <Target Name="GetDependencyTargetPaths" AfterTargets="ResolvePackageDependenciesForBuild">
    <ItemGroup>
      <None Include="$(OutputPath)\$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/cs" />

      <None Include="$(PKGGaryon)\lib\netstandard2.0\*.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    </ItemGroup>
  </Target>

</Project>
