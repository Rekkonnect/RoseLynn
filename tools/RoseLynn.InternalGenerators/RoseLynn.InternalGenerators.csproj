<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <NoWarn>$(NoWarn);RS1042;RS1038</NoWarn>

    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <Configurations>Debug;Release</Configurations>
  </PropertyGroup>

  <Import Project="../build/InferTransitiveDependencies.props" />

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="$(MicrosoftCodeAnalysisVersion)">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>

    <PackageReference Include="Microsoft.CodeAnalysis" Version="$(MicrosoftCodeAnalysisVersion)" PrivateAssets="all" />

    <!-- The meta is too strong in this one-->
    <PackageReference Include="Garyon" Version="0.5.0" PrivateAssets="all" />
    <PackageReference Include="RoseLynn" Version="$(RoseLynnLegacyVersion)" PrivateAssets="all" />
    <PackageReference Include="RoseLynn.VS2019" Version="$(RoseLynnLegacyVersion)" PrivateAssets="all" />
    <PackageReference Include="RoseLynn.Analyzers" Version="$(RoseLynnLegacyVersion)" PrivateAssets="all" />
    <PackageReference Include="RoseLynn.Analyzers.VS2019" Version="$(RoseLynnLegacyVersion)" PrivateAssets="all" />
    <PackageReference Include="RoseLynn.Generators" Version="$(RoseLynnLegacyVersion)" PrivateAssets="all" />
    <PackageReference Include="RoseLynn.Generators.VS2019" Version="$(RoseLynnLegacyVersion)" PrivateAssets="all" />
  </ItemGroup>

  <PropertyGroup>
    <GetTargetPathDependsOn>$(GetTargetPathDependsOn);GetDependencyTargetPaths</GetTargetPathDependsOn>
  </PropertyGroup>

  <Target Name="GetDependencyTargetPaths" AfterTargets="ResolvePackageDependenciesForBuild">
    <ItemGroup>
      <None Include="$(OutputPath)\$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/cs" />

      <None Include="$(PKGGaryon)\lib\netstandard2.0\*.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    </ItemGroup>
  </Target>

</Project>
