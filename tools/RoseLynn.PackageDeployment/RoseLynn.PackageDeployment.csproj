<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Configurations>Debug;Release;Release Test</Configurations>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Garyon" Version="0.5.0" />
    <PackageReference Include="CliWrap" Version="3.9.0" />
    <PackageReference Include="DotNetEnv" Version="3.2.0" />
    <PackageReference Include="NuGet.PackageManagement" Version="$(NuGetClientVersion)" />
    <PackageReference Include="NuGet.Packaging" Version="$(NuGetClientVersion)" />
    <PackageReference Include="NuGet.Protocol" Version="$(NuGetClientVersion)" />
    <PackageReference Include="Spectre.Console" Version="0.49.1" />
    <PackageReference Include="Spectre.Console.Cli" Version="0.49.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\RoseLynn\RoseLynn.csproj" />
  </ItemGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release Test|AnyCPU'">
    <DefineConstants>
      $(DefineConstants);
      TEST_PACKAGES;
    </DefineConstants>
  </PropertyGroup>

</Project>
